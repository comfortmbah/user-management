<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <a href="/create">Add User</a>

    <% users.forEach(user => { %>
      <div>
        <p>
          ID: <%= user.id %>
        </p>

        <p>
          Name: <%= user.firstName %> <%= user.lastName %>
        </p>

        <p>Email: <%= user.email %></p>

        <p>Age: <%= user.age %></p>

        <p>Bio: <%= user.bio %></p>
      </div>
      <hr>

    <% }) %>
</body>
</html>