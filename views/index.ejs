<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <% users.forEach(user => { %>
      <div>
        <p>
          ID: <%= user.id %>
        </p>

        <p>
          Name: <%= user.firstName %> <%= user.lastName %>
        </p>
      </div>
    <% }) %>
</body>
</html>