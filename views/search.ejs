<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <h1><%= title %></h1>

    <p>Search:
        <% if (name) { %>
          Name: <%= name %>
        <% } %>

        <% if (email) { %>
          Email: <%= email %>
        <% } %>
    </p>

    <% if (users.length === 0) { %>
       <p>No users found.</p>
    <% } else { %>
       <% users.forEach(user => { %>
      <div>
        <p>
          ID: <%= user.id %>
        </p>

        <p>
          Name: <%= user.firstName %> <%= user.lastName %>
        </p>

        <p>Email: <%= user.email %></p>

        <p>Age: <%= user.age %></p>

        <p>Bio: <%= user.bio %></p>
      <% }) %>
    }
</body>
</html>